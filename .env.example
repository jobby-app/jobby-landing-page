# Frontend (opcjonalnie — domyślnie używa /api/waitlist na tym samym hoście)
# VITE_WAITLIST_API_URL=/api/waitlist

# Railway — ustaw w Variables serwisu (Postgres dodaje DATABASE_URL automatycznie)
DATABASE_URL=postgresql://user:pass@host:5432/railway
PORT=3000
NODE_ENV=production

# Resend (maile z własnej domeny)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Jobby <waitlist@getjobby.pl>

# Sekret do wysyłki zaproszeń beta (min. 32 losowe znaki)
ADMIN_SECRET=wygeneruj-dlugie-losowe-haslo-min-32-znaki

# URL strony (logo w mailach) — ustaw na produkcji, np. https://www.getjobby.pl
SITE_URL=https://www.getjobby.pl
